{
  "name": "@kefka/pi-web",
  "version": "0.1.1",
  "description": "Pi extension: /web command — local web console sharing the TUI session (chat, sessions, models) over WebSocket",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/maybe-kefka/pi-extensions.git"
  },
  "files": [
    "src",
    "web/dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "cd web && npm run build && cd .. && npm run typecheck && npm test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/ws": "^8.5.13"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
